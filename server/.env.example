# 复制为 .env 并填入真实配置（.env 已被 .gitignore 忽略，绝不提交到仓库）

# 服务端口
PORT=3001

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=english_app
DB_PASSWORD=改成强密码
DB_NAME=english_learning

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 密钥（登录功能必需，至少 16 位随机字符串）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
